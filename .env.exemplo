# MODELO. Copie para ".env" e preencha. Este arquivo vai para o Git: NUNCA coloque valores reais aqui.

# Pegue em https://my.telegram.org -> API development tools
API_ID=
API_HASH=

# Login do Telegram para a nuvem: gerado por "python gerar_sessao.py" (SEGREDO)
TG_SESSION=

# Canal oficial da Magalu (o @ ou o link t.me/...)
CANAL_ORIGEM=@parceiromagaludivulgador

# Nome da sua loja Parceiro Magalu (a parte depois de "magazine" no seu link)
LOJA_MAGALU=

# Formato do link de parceiro
LINK_TEMPLATE=https://www.magazinevoce.com.br/magazine{loja}/p/{id}/

# Para onde mandar os posts:
#   me            -> suas Mensagens Salvas (você revisa antes de postar)
#   @seucanal     -> direto no seu canal (sua conta precisa ser admin dele)
#   -100...       -> canal privado (ID criado pelo criar_canal.py)
DESTINO=me

# Filtros: NICHO=baby usa palavras_baby.txt (deixe vazio para receber tudo)
DESCONTO_MINIMO=0
NICHO=baby

# Postagem agendada da Shopee (postar_shopee.py --agendado), horário de Brasília
POSTAR_DAS=8
POSTAR_ATE=22
INTERVALO_MIN=40

# Avançado: regex própria para achar o ID, se o padrão automático errar
ID_REGEX=
